# Database (use a pooled connection string on Vercel)
DATABASE_URL=postgresql://travel:travel@localhost:5433/travel

# Auth.js: generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=change-me
# Created or updated by `pnpm db:seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-password

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=919800000000
# Needed only when running a production build outside Vercel (Vercel is trusted automatically)
AUTH_TRUST_HOST=true
